{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hylia",
  "main": "worker/dist/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./docs",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hylia-github",
      "database_id": "bdaffdbe-1568-4343-b1aa-f885b8a7f8eb",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "hylia-github-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
